# Copy to .env and fill in. Leave OPENAI_API_KEY empty to use the offline deterministic planner.
OPENAI_API_KEY=
AGENT_LLM_MODE=auto

# OpenAI (defaults)
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_COMPLETIONS_PATH=/v1/chat/completions
# OPENAI_MODEL=gpt-4o

# Google Gemini via its OpenAI-compatible endpoint (tested; put the Gemini API key in OPENAI_API_KEY).
# Flash-Lite is the recommended demo model (about 1.5-2.7 s per turn); see README "LLM provider".
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_COMPLETIONS_PATH=/chat/completions
# OPENAI_MODEL=gemini-3.1-flash-lite
# AGENT_LLM_REASONING_EFFORT=low

# How LLM mode runs a turn: single-pass (Java tool plan + 1 model call, default) or agentic (model calls tools)
# AGENT_LLM_ORCHESTRATION=single-pass
# AGENT_LLM_SYNTHESIS_TIMEOUT_MS=8000
# Model HTTP read timeout, retries per call, and the circuit breaker (skip the model after N failures).
# AGENT_LLM_HTTP_READ_TIMEOUT_SECONDS=30
# AGENT_LLM_RETRY_MAX_ATTEMPTS=2
# AGENT_LLM_CIRCUIT_FAILURE_THRESHOLD=3
# AGENT_LLM_CIRCUIT_OPEN_SECONDS=60
# Backup models tried when the configured model returns HTTP 503 (busy) or hits the read timeout (once per call). Empty = off.
# Use a model different from OPENAI_MODEL, ideally the same family (Gemini 3 Flash models work in agentic mode).
# AGENT_LLM_FALLBACK_MODELS=gemini-3.1-flash-lite
# AGENT_LLM_FALLBACK_STICKY_SECONDS=60
# Static prompt prefix for provider caching (false = short prompt only, for A/B comparison)
# AGENT_PROMPT_CACHING=true

# Optional: enable JWT validation (otherwise all endpoints are open for the local demo)
# OAUTH2_ISSUER_URI=https://your-idp.example.com/oauth2/default
